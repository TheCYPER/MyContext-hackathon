{
  "name": "mycontext",
  "version": "0.1.0",
  "private": true,
  "description": "Inspectable personal context for your AI, stored in Markdown and Git.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "bash scripts/setup.sh demo",
    "setup:empty": "bash scripts/setup.sh empty",
    "start": "node dashboard/server.mjs",
    "start:empty": "node dashboard/server.mjs --root .local/empty",
    "test": "bash scripts/check.sh --tree ."
  }
}
